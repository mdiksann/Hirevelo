# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment files; commit only the documented example
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local CV storage (never commit uploaded files)
/storage/
/playwright-report/
/test-results/
/blob-report/
# Temporary route created only by test:e2e and removed on exit
/src/app/foundation-test-error/

# Generated design explorations and unused export sets; retain Markdown notes
/design/logo-concepts/*
!/design/logo-concepts/*.md
/public/brand/variants/
/public/icons/3d/*.png

# Local tool settings and credentials
/.agents/
/.codex/
/.aws/
/.idea/
/.vscode/
*.key
*.p12
*.pfx

# Local logs and editor temporary files
*.log
*.swp
*.swo
*~
Thumbs.db

# Docs
TASKS.md
AGENTS.md
DESIGN.md
PROJECT_SPEC.md
CLAUDE.md
ui-guide.png
ENGINEERING.md
push.sh
