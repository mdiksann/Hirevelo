# Local development values only. Choose strong secrets for deployments.
DATABASE_URL=postgresql://hirevelo:hirevelo_local@localhost:5432/hirevelo?schema=public
# Integration tests require a separate disposable database named hirevelo_test.
DATABASE_URL_TEST=postgresql://hirevelo:hirevelo_local@localhost:5432/hirevelo_test?schema=public
AUTH_SECRET=local-development-only-change-before-deploy
AUTH_URL=http://localhost:3000
STORAGE_DIR=./storage/cv
# Both seed values are optional in development; provide both in production.
SEED_RECRUITER_EMAIL=recruiter@example.com
SEED_RECRUITER_PASSWORD=Demo-password-123
LOG_LEVEL=debug
# NODE_ENV is set by Next.js (development/production/test).
